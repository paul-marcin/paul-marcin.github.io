---
import PageLayout from '@/layouts/BaseLayout.astro'
import StoryPreview from '@/components/home/StoryPreview.astro'
import { categoryLabels, postsIn, type Category } from '@/utils/categories'
import { sortMDByDate } from 'astro-pure/server'
import { localizedContent } from '@/utils/content'
import { localeFromPath, choose, localPath } from '@/utils/i18n'

const locale = localeFromPath(Astro.url.pathname)
const posts = sortMDByDate(await localizedContent('blog', locale))

// Trois colonnes, deux aperçus chacune : les textes les plus récents de chaque domaine.
const columns = (['recherche', 'psychiatrie', 'politique'] as Category[]).map((category) => ({
  category,
  ...categoryLabels(category, locale),
  posts: postsIn(posts, category).slice(0, 2)
}))
---

<PageLayout meta={{ title: choose(locale, 'Accueil', 'Home') }} data-page='home'>
  <main class='home'>
    <section class='animate introduction' id='content-header' aria-labelledby='intro-title'>
      <p class='eyebrow'>{choose(locale, 'Un espace pour partager mes réflexions', 'A space to share my reflections')}</p>
      <h1 id='intro-title'>{choose(locale, 'Mieux vivre, avec soi‑même', 'Living better, with ourselves')}<br />{choose(locale, 'et en société.', 'and with others.')}</h1>
      <p class='intro-copy'>
        {choose(locale, 'Mes recherches et mes réflexions partent d’une même question : qu’est-ce qui nous aide à mieux vivre, avec nous-mêmes et avec les autres ?', 'My research and reflections begin with the same question: what helps us live better, with ourselves and with others?')}
      </p>
      <p class='intro-copy secondary'>
        {choose(locale, 'J’explore cette question à travers les sciences cognitives, la psychiatrie, la politique et nos relations. Je partage ici des travaux et des essais pour mieux comprendre nos expériences et les conditions de notre vie collective.', 'I explore this question through cognitive science, psychiatry, politics and our relationships. Here I share research and essays to better understand our experiences and the conditions of our collective lives.')}
      </p>
    </section>

    <div id='content' class='animate'>
      <p class='section-heading'>{choose(locale, 'Une sélection à travers trois domaines', 'A selection across three fields')}</p>
      <div class='topic-columns'>
        {
          columns.map(({ category, title, page, linkLabel, posts }) => (
            <section class='topic-column' aria-labelledby={`${category}-heading`}>
              <h2 id={`${category}-heading`}>{title}</h2>
              {posts.map((post) => (
                <StoryPreview {post} />
              ))}
              <a class='topic-link' href={localPath(page, locale)}>
                {linkLabel} →
              </a>
            </section>
          ))
        }
      </div>
    </div>
  </main>
</PageLayout>

<style>
  .home {
    padding-block: 2rem 3rem;
  }
  .introduction {
    margin-bottom: 3rem;
  }
  .eyebrow,
  .section-heading {
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: hsl(var(--muted-foreground));
    margin: 0;
  }
  h1 {
    font-size: clamp(2rem, 4.8vw, 3.5rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.02em;
    margin: 0.6rem 0 1.1rem;
  }
  .intro-copy {
    max-width: 65ch;
    line-height: 1.65;
    margin: 0.6rem 0;
  }
  .secondary {
    font-size: 0.95rem;
    color: hsl(var(--muted-foreground));
  }
  .section-heading {
    border-top: 1px solid hsl(var(--border));
    padding: 1.3rem 0 1.6rem;
  }

  /* Colonnes alignées par une grille commune : tous les aperçus ont la hauteur du plus long. */
  .topic-columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: auto repeat(2, 1fr) auto;
    column-gap: 2rem;
  }
  .topic-column {
    grid-row: 1 / -1;
    display: grid;
    grid-template-rows: subgrid;
    row-gap: 1.7rem;
    min-width: 0;
  }
  .topic-column > h2 {
    align-self: end;
    font-size: 1.2rem;
    font-weight: 400;
    border-bottom: 1px solid hsl(var(--foreground) / 0.5);
    padding-bottom: 0.8rem;
    margin: 0;
  }
  .topic-link {
    grid-row: -2;
    font-size: 0.85rem;
    padding: 0.25rem 0;
    color: hsl(var(--primary));
  }
  .topic-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 950px) {
    .topic-columns {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      row-gap: 2.5rem;
    }
    .topic-column {
      grid-row: auto;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }
    .topic-column > h2 {
      align-self: auto;
    }
  }
</style>
