---
import PageLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/home/Section.astro';
import { PostPreview } from 'astro-pure/components/pages';
import { getBlogCollection, sortMDByDate } from 'astro-pure/server';
import { Button } from 'astro-pure/user';
const posts = sortMDByDate(await getBlogCollection());
---
<PageLayout meta={{ title: 'Accueil' }} highlightColor="#659EB9">
  <main class="flex w-full flex-col items-center">
    <section class="animate mb-10 flex max-w-3xl flex-col gap-y-5" id="content-header">
      <p class="text-sm text-muted-foreground">Recherche & réflexions</p>
      <h1 class="text-3xl font-medium sm:text-4xl">Mieux vivre, avec soi-même et en société.</h1>
      <p class="text-muted-foreground">Mes recherches et mes réflexions partent d’une même question : qu’est-ce qui nous aide à mieux vivre, avec nous-mêmes et avec les autres ?</p>
      <p class="text-muted-foreground">J’explore cette question à travers les sciences cognitives, la psychiatrie, la politique et nos relations.</p>
    </section>
    <div id="content" class="animate w-full flex flex-col gap-y-10 md:w-4/5 lg:w-5/6">
      <Section title="Articles d’exemple">
        <p class="text-muted-foreground">Les textes du starter sont conservés pour vérifier la base Pure. Ils ne constituent pas des publications personnelles.</p>
        <ul class="flex flex-col gap-y-3">{posts.map(post => <PostPreview post={post} detailed />)}</ul>
        <Button title="Tous les articles" href="/blog/" variant="ahead" class="w-fit self-end" />
      </Section>
    </div>
  </main>
</PageLayout>
