---
import { type CollectionEntry, render } from 'astro:content'
import BlogPost from '../../../layouts/BlogPost.astro'
import { localizedContent } from '@/utils/content'

export async function getStaticPaths() {
  return (await localizedContent('blog', 'en')).map((post) => ({
    params: { slug: post.id.replace(/^en\//, '') }, props: post
  }))
}
type Props = CollectionEntry<'blog'>
const post = Astro.props
const { Content, headings, remarkPluginFrontmatter } = await render(post)
const posts = (await localizedContent('blog', 'en')).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
---
<BlogPost {post} {posts} {headings} {remarkPluginFrontmatter}>
  <Content />
</BlogPost>
