---
import { Footer, Header, ThemeProvider } from 'astro-pure/components/basic'
import type { SiteMeta } from 'astro-pure/types'
import BaseHead from '@/components/BaseHead.astro'
import { localeFromPath, siteDescription } from '@/utils/i18n'

// Import the global.css file here so that it is included on
// all pages through the use of the <BaseLayout /> component.
import '@/assets/styles/global.css'
import '@/assets/styles/app.css'
import '@/assets/styles/design-tokens.css'

interface Props {
  meta: SiteMeta
  highlightColor?: string
}

const {
  meta: { articleDate, description, ogImage, title },
  highlightColor,
  ...props
} = Astro.props
const locale = localeFromPath(Astro.url.pathname)
---

<html lang={locale}>
  <head>
    <BaseHead {articleDate} description={description ?? siteDescription(locale)} {ogImage} {title} />
    <ThemeProvider />
  </head>

  <body class='flex justify-center bg-background text-foreground' {...props}>
    {/* Halo : couleur de lecture dédiée (design-tokens.css) */}
    {
      highlightColor && (
        <div
          id='highlight-gradient'
          class='pointer-events-none absolute start-0 top-0 z-0 w-full'
          style='height:var(--article-halo-height, 0px);background-image:linear-gradient(hsl(var(--article-halo)),transparent)'
        />
      )
    }
    <div
      id='main-container'
      class='w-full max-w-[70rem] min-h-[100dvh] flex flex-col justify-between'
    >
      <Header />
      <div class='flex-1 w-full'>
        <slot />
      </div>
      <Footer />
    </div>

    {/* Set highlight color */}
    <style define:vars={{ highlightColor }}>
      :global(.highlight) {
        --highlight-fg: color-mix(
          in srgb,
          var(--highlightColor) 40%,
          hsl(var(--foreground)/var(--un-text-opacity, 1))
        );
        color: var(--highlight-fg, hsl(var(--primary) / var(--un-text-opacity))) !important;
      }
      :global(.highlight-bg) {
        background-color: var(
          --highlightColor,
          hsl(var(--primary) / var(--un-text-opacity))
        ) !important;
      }

      /* Extend safe area for some special screens
       * https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Values/env
       * https://webkit.org/blog/7929/designing-websites-for-iphone-x/
       */
      #main-container {
        padding-top: env(safe-area-inset-top);
        padding-left: calc(1rem + env(safe-area-inset-left));
        padding-right: calc(1rem + env(safe-area-inset-right));
      }
      @media (min-width: 640px) {
        #main-container {
          padding-left: calc(1.75rem + env(safe-area-inset-left));
          padding-right: calc(1.75rem + env(safe-area-inset-right));
        }
      }
      @media (min-width: 1024px) {
        #main-container {
          padding-left: calc(2.5rem + env(safe-area-inset-left));
          padding-right: calc(2.5rem + env(safe-area-inset-right));
        }
      }
    </style>
  </body>
</html>

<script>
  const halo = document.getElementById('highlight-gradient')
  const heading = document.getElementById('content-header')
  const container = document.getElementById('main-container')

  if (halo && heading && container) {
    const updateHalo = () => {
      // Layout coordinates ignore the entrance animation's visual translation.
      let bottom = heading.offsetHeight
      let element: HTMLElement | null = heading
      while (element) {
        bottom += element.offsetTop
        element = element.offsetParent as HTMLElement | null
      }
      halo.style.setProperty('--article-halo-height', `${bottom}px`)
    }

    const observer = new ResizeObserver(updateHalo)
    observer.observe(heading)
    observer.observe(container)
    window.addEventListener('resize', updateHalo)
    document.fonts.ready.then(updateHalo)
    updateHalo()
  }
</script>
