---
import type { HTMLAttributes } from 'astro/types'

import { cn } from '../../utils'
import { localeFromPath } from '@/utils/i18n'

type Props = HTMLAttributes<'time'> & {
  date: Date
  dateTimeOptions?: Intl.DateTimeFormatOptions
  class?: string
}

const { date, dateTimeOptions, class: className, ...attrs } = Astro.props

const postDate = new Intl.DateTimeFormat(localeFromPath(Astro.url.pathname) === 'en' ? 'en-GB' : 'fr-FR', {
  day: 'numeric', month: 'short', year: 'numeric', ...dateTimeOptions
}).format(date)
---

<span class={cn('text-muted-foreground font-mono', className)} {...attrs}>
  <time datetime={date.toISOString()}>
    {postDate}
  </time>
</span>
